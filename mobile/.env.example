# --- Local Expo Go (Mac must be on, same Wi‑Fi) ---
# Leave EXPO_PUBLIC_API_BASE_URL unset — app auto-uses http://<metro-lan-host>:3001
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3001
#
# iOS Simulator only:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
#
# --- Hosted preview app (laptop off) ---
# Do NOT set here. EAS preview builds bake the URL from mobile/eas.json
# (see hosted.config.json + docs/MOBILE_HOSTED_SETUP.md).
# EXPO_PUBLIC_API_BASE_URL=https://padel-analyzer.fly.dev
