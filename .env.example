# Local / hosted environment template. Copy to `.env` — never commit real keys.
# Fly: set these as secrets, not in this file.

# off = open API (Playwright, local CV). on = magic-link + per-user isolation.
AUTH_MODE=off

# Required when AUTH_MODE=on in production. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-insecure-change-me

# Magic-link email. console logs the URL; resend sends mail.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Padel Analyzer <noreply@example.com>
PUBLIC_APP_URL=http://localhost:3001

# Seed + backfill owner for rows with null user_id
AUTH_ADMIN_EMAIL=operator@localhost

# Hosted beta is pose-only. Set true to enable ball/racket CV locally.
BALL_TRACKING_ENABLED=false

# Optional
# SENTRY_DSN=
# SLACK_FEEDBACK_WEBHOOK_URL=
# PADEL_DATA_DIR=./data
# PORT=3001
